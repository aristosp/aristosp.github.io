---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found">
  <div class="container page-intro">
    <span class="eyebrow">404 / Not found</span>
    <h1 class="page-title">This page isn't here.</h1>
    <p>Try the homepage or use the navigation to find the section you're looking for.</p>
    <a class="button button-primary" href="/">Back home ↗</a>
  </div>
</BaseLayout>
