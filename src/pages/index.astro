---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import AuthorLine from "@/components/AuthorLine.astro";
import { site } from "@/data/site";
import { researchAreas, projects, publications, teaching, cvSections } from "@/data/content";
---
<BaseLayout title={`${site.name} | Multimodal Speech Recognition`}>
  <div class="container home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <span class="eyebrow"><span class="availability-dot"></span> PhD researcher · Trinity College Dublin</span>
        <h1 id="home-title">I study how machines learn to <span>understand speech.</span></h1>
        <p class="hero-summary">I’m Aristeidis, a researcher exploring what happens when audio and vision work together—from recognising speech to understanding what a model has learned.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#research">Explore my research <span aria-hidden="true">↓</span></a>
          <a class="button button-secondary" href={site.cv} target="_blank" rel="noreferrer">Download CV <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-links" aria-label="Social profiles">
          <a href={site.links.scholar} target="_blank" rel="noreferrer">Google Scholar <span aria-hidden="true">↗</span></a>
          <a href={site.links.orcid} target="_blank" rel="noreferrer">ORCID <span aria-hidden="true">↗</span></a>
          <a href={site.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-portrait">
        <div class="portrait-frame">
          <img src={site.profileImage} alt="Aristeidis Papadopoulos" />
          <span class="portrait-note">Researching speech<br />at the intersection of<br />sound & sight.</span>
        </div>
        <div class="portrait-caption"><span>{site.location}</span><span>40° 05′ N &nbsp; 9° 56′ W</span></div>
      </div>
      <a class="scroll-cue" href="#research"><span class="scroll-line"></span> Scroll to explore</a>
    </section>

    <section class="home-section research-section" id="research">
      <SectionHeading eyebrow="01 — What I do" title="Research, in focus." description="How do we build speech systems that can see, listen, and make sense of both?" />
      <div class="research-grid">
        {researchAreas.map((area) => <article class="research-card">
          <span class="card-index">{area.number}</span>
          <div><h3>{area.title}</h3><p>{area.description}</p>
            <div class="tags">{area.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          </div>
        </article>)}
      </div>
      <a class="section-more" href="/research/">A little more about my research <span aria-hidden="true">↗</span></a>
    </section>

    <section class="home-section publications-section" id="publications">
      <SectionHeading eyebrow="02 — Selected writing" title="Research out in the world." description="Papers and work exploring visual speech, model representations, and robust recognition." />
      <div class="publication-rail" role="region" tabindex="0" aria-label="Publications; scroll horizontally to browse">
        {publications.map((paper) => <article class="publication-tile">
          <div class="publication-topline"><span>{paper.type}</span><span>{paper.year}</span></div>
          <h3>{paper.title}</h3>
          <p class="publication-venue">{paper.venue}</p>
          <p class="publication-authors"><AuthorLine authors={paper.authors} name={site.name} /></p>
          <div class="publication-links">
            {paper.paper && <a class="section-more" href={paper.paper} target="_blank" rel="noreferrer">Read the paper <span aria-hidden="true">↗</span></a>}
            {paper.doi && <a class="section-more" href={`https://doi.org/${paper.doi}`} target="_blank" rel="noreferrer">DOI <span aria-hidden="true">↗</span></a>}
            {paper.code && <a class="section-more" href={paper.code} target="_blank" rel="noreferrer">Code <span aria-hidden="true">↗</span></a>}
            {!paper.paper && <a class="section-more" href={paper.legacy}>Publication details <span aria-hidden="true">↗</span></a>}
          </div>
        </article>)}
      </div>
      <p class="rail-hint"><span aria-hidden="true">←</span> Swipe or scroll to explore <span aria-hidden="true">→</span></p>
      <a class="section-more" href="/publications/">All publications <span aria-hidden="true">↗</span></a>
    </section>

    <section class="home-section projects-section" id="projects">
      <SectionHeading eyebrow="03 — Selected work" title="Curiosity, put to work." description="A few projects from beyond the PhD—building, testing, and learning by doing." />
      <div class="project-grid">
        {projects.map((project, index) => <article class="feature-project">
          <div class="project-image-wrap">
            {project.image && <img src={project.image} alt="" loading="lazy" />}
            <span class="project-number">0{index + 1}</span>
          </div>
          <div class="project-copy">
            <span class="project-category">{project.category}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
            <div class="project-actions">
              <a class="section-more" href={project.github} target="_blank" rel="noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
              {project.thesis && <a class="section-more" href={project.thesis} target="_blank" rel="noreferrer">Read thesis <span aria-hidden="true">↗</span></a>}
            </div>
          </div>
        </article>)}
      </div>
    </section>

    <section class="home-section teaching-section" id="teaching">
      <SectionHeading eyebrow="04 — Along the way" title="Teaching & education." description="Learning is better when it’s shared. I teach engineering and help students connect theory with practice." />
      <div class="journey-grid">
        <div class="teaching-list">
          <h3 class="subsection-title">Teaching</h3>
          {teaching.map((item) => <article class="teaching-item">
            <span class="teaching-period">{item.period}</span>
            <div>
              <h4>{item.url ? <a href={item.url} target="_blank" rel="noreferrer">{item.course} <span aria-hidden="true">↗</span></a> : item.course}</h4>
              <p>{item.role}</p>
              <span class="teaching-institution">{item.institution}</span>
            </div>
          </article>)}
          <a class="section-more" href="/teaching/">Teaching details <span aria-hidden="true">↗</span></a>
        </div>
        <div class="education-panel">
          <h3 class="subsection-title">Education</h3>
          {cvSections.find((section) => section.title === "Education")?.items.map((item) => <article class="education-item">
            <span class="teaching-period">{item.period}</span>
            <h4>{item.title}</h4>
            <p>{item.organisation}</p>
          </article>)}
          <a class="section-more" href="/cv/">Full CV <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="contact-panel" id="contact">
      <div>
        <span class="eyebrow">05 — Say hello</span>
        <h2>Good ideas start<br />with a conversation.</h2>
        <p>For research discussions, academic enquiries, or a shared curiosity about speech and machine learning. Or just a good chat—I love those, too.</p>
      </div>
      <div class="contact-actions">
        <a class="button button-primary" href={`mailto:${site.email}`}>Email me <span aria-hidden="true">↗</span></a>
        <span>{site.email}</span>
        <a class="contact-cv" href={site.cv} target="_blank" rel="noreferrer">Or take a look at my CV <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
