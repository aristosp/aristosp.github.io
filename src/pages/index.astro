---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { site } from "@/data/site";
import { researchAreas, projects, publications } from "@/data/content";
---
<BaseLayout title={`${site.name} | Multimodal Speech Recognition`}>
  <div class="container">
    <section class="hero hero-profile">
      <div>
        <span class="eyebrow">PhD Researcher · Trinity College Dublin</span>
        <h1>Understanding speech through <span class="gradient-text">audio, vision and representation learning.</span></h1>
        <p class="lead">I am a PhD researcher at Trinity College Dublin working on neural architectures for multimodal speech recognition. My research explores audio-visual speech recognition, viseme representations and the interpretability of multimodal models.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/research/">Explore my research <span>↗</span></a>
          <a class="button button-secondary" href="/publications/">View publications</a>
        </div>
        <div class="social-row">
          <a href={site.links.scholar} target="_blank" rel="noreferrer">Google Scholar ↗</a>
          <a href={site.links.orcid} target="_blank" rel="noreferrer">ORCID ↗</a>
          <a href={site.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
      </div>
      <div class="profile-panel">
        <img class="profile-photo" src={site.profileImage} alt="Portrait of Aristeidis Papadopoulos" />
        <div class="profile-caption"><strong>Aristeidis Papadopoulos</strong><span>Dublin, Ireland</span></div>
        <div class="profile-lines"><span>RESEARCH</span><b>Audio-visual speech recognition</b><span>INSTITUTION</span><b>Trinity College Dublin</b></div>
      </div>
    </section>

    <section class="section">
      <SectionHeading eyebrow="01 / Research" title="Research interests" description="Questions around how audiovisual systems represent and use visual speech information." />
      <div class="card-grid">{researchAreas.map((area) => <article class="card">
        <span class="card-index">{area.number} / AREA</span><h3>{area.title}</h3><p>{area.description}</p>
        <div class="tags">{area.tags.map(tag => <span class="tag">{tag}</span>)}</div>
      </article>)}</div>
      <a class="text-link" href="/research/">More about my research ↗</a>
    </section>

    <section class="section">
      <SectionHeading eyebrow="02 / Selected work" title="Projects" description="Academic and technical projects spanning audio classification and image processing." />
      <div class="card-grid">{projects.map((project) => <article class="card project-card">
        {project.image && <img class="project-thumb" src={project.image} alt="" loading="lazy" />}
        <span class="card-index">{project.category}</span><h3>{project.title}</h3><p>{project.description}</p>
        <a class="text-link" href={project.github} target="_blank" rel="noreferrer">Explore repository ↗</a>
      </article>)}</div>
      <a class="text-link" href="/projects/">View all projects ↗</a>
    </section>

    <section class="section">
      <SectionHeading eyebrow="03 / Publications" title="Recent research" description="Selected research outputs on viseme representations and audiovisual speech recognition." />
      <div class="content-list compact-list">{publications.map((paper) => <article class="content-card">
        <span class="content-meta">{paper.year} · {paper.type}</span><h2>{paper.title}</h2><p>{paper.authors} · {paper.venue}</p>
      </article>)}</div>
      <a class="text-link" href="/publications/">Browse all publications ↗</a>
    </section>

    <section class="section contact-section">
      <SectionHeading eyebrow="04 / Contact" title="Get in touch" description="For research discussions, academic enquiries and potential collaborations." />
      <div class="hero-actions">
        <a class="button button-primary" href={`mailto:${site.email}`}>Email me ↗</a>
        <a class="button button-secondary" href={site.cv}>Download CV (PDF) ↗</a>
      </div>
    </section>
  </div>
</BaseLayout>
