---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
import { projects } from "@/data/content";
---
<BaseLayout title={`Projects | ${site.name}`}>
  <div class="container">
    <header class="page-intro"><span class="eyebrow">Projects</span><h1 class="page-title">Selected projects</h1>
      <p>Academic projects and implementations developed during my studies in electrical and computer engineering.</p>
    </header>
    <section class="content-list">{projects.map((project) => <article class="content-card project-detail">
      {project.image && <img class="project-detail-image" src={project.image} alt={`Illustration for ${project.title}`} loading="lazy" />}
      <div><span class="content-meta">{project.category}</span><h2>{project.title}</h2><p>{project.description}</p><div class="tags">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div>
      <a class="text-link" href={project.github} target="_blank" rel="noreferrer">View source code on GitHub ↗</a></div>
    </article>)}</section>
  </div>
</BaseLayout>
